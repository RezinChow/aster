{
  "name": "openai_tools_roundtrip",
  "description": "Tool definitions, a tool-bearing conversation, and a tool-result turn survive translation in both directions.",
  "openai": {
    "model": "chat-model",
    "messages": [
      { "role": "system", "content": "You manage shipments." },
      { "role": "user", "content": "Where is order 5001?" },
      {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "call_1",
            "type": "function",
            "function": {
              "name": "lookup_order",
              "arguments": "{\"order_id\": \"5001\"}"
            }
          }
        ]
      },
      { "role": "tool", "tool_call_id": "call_1", "content": "{\"status\": \"in transit\"}" }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "lookup_order",
          "description": "Look up one order by id.",
          "parameters": {
            "type": "object",
            "properties": { "order_id": { "type": "string" } },
            "required": ["order_id"]
          }
        }
      }
    ],
    "tool_choice": "auto",
    "max_tokens": 512,
    "temperature": 0.2,
    "stop": ["\n\nUser:"]
  },
  "anthropic": {
    "model": "chat-model",
    "max_tokens": 512,
    "temperature": 0.2,
    "stop_sequences": ["\n\nUser:"],
    "system": "You manage shipments.",
    "tools": [
      {
        "name": "lookup_order",
        "description": "Look up one order by id.",
        "input_schema": {
          "type": "object",
          "properties": { "order_id": { "type": "string" } },
          "required": ["order_id"]
        }
      }
    ],
    "tool_choice": { "type": "auto" },
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "Where is order 5001?" }] },
      {
        "role": "assistant",
        "content": [
          {
            "type": "tool_use",
            "id": "call_1",
            "name": "lookup_order",
            "input": { "order_id": "5001" }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "call_1",
            "content": "{\"status\": \"in transit\"}"
          }
        ]
      }
    ]
  }
}
