{
  "name": "multimodal_passthrough_pair",
  "description": "Native multimodal content blocks pass through translation unchanged: image inputs stay image inputs on both dialects.",
  "openai": {
    "model": "chat-model",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in this shipment photo?" },
          {
            "type": "image_url",
            "image_url": { "url": "data:image/png;base64,aGVsbG8=" }
          }
        ]
      }
    ],
    "max_tokens": 128
  },
  "anthropic": {
    "model": "chat-model",
    "max_tokens": 128,
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "What is in this shipment photo?" },
          {
            "type": "image",
            "source": {
              "type": "base64",
              "media_type": "image/png",
              "data": "aGVsbG8="
            }
          }
        ]
      }
    ]
  }
}
