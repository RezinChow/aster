extension "a3s/meeting" {
  schema_version = 3
  version        = "0.1.0"
  route          = "meeting"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://a3s.dev/packages/applets/meeting"
    revision = "0000000000000000000000000000000000000000"
  }

  ui "meeting" {
    point = "studio.applets"
    entry = "ui/home/index.html"
  }
}
