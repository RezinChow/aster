# a3s-api (default via rsbuild proxy /api → :3000)
# PUBLIC_A3S_API_BASE=/api

# WeChat Open Platform website app. The org login QR encodes this app id.
# PUBLIC_WECHAT_APP_ID=

# Kense Gateway base for Work Connect (Capability Key data plane — NOT a3s-api)
# PUBLIC_GATEWAY_BASE_URL=https://gw.example.com/v1

# Cloud Project/Env ScopeSwitcher uses a3s-api read-through:
#   GET /api/identity/cloud/projects
# Configure A3S_CLOUD_* on the API process — never expose Cloud tokens to the browser.
