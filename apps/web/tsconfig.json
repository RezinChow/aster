{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2022"
    ],
    "types": [
      "@rsbuild/core/types",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@a3s/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@a3s/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@a3s-lab/flow-ui/react": [
        "../../crates/flow/packages/ui/dist/react.d.ts"
      ],
      "@a3s-lab/flow-ui": [
        "../../crates/flow/packages/ui/dist/index.d.ts"
      ],
      "@a3s-lab/flow-ui/styles.css": [
        "../../crates/flow/packages/ui/src/styles.css"
      ],
      "@a3s-lab/office/react": [
        "../../packages/office/dist/react.d.ts"
      ],
      "@a3s-lab/office/core": [
        "../../packages/office/dist/core.d.ts"
      ],
      "@a3s-lab/office": [
        "../../packages/office/dist/index.d.ts"
      ],
      "@rspress/core/runtime": [
        "src/flow-designer/rspress-shim.ts"
      ]
    }
  },
  "include": [
    "src",
    "rsbuild.config.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
