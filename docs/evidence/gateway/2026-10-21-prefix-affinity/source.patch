+        .unwrap();
+    affinity.accepted(&hint, candidate(1, 0).signature, now);
+    for scope in [
+        ("credential-b", 1, "model-a", "chat"),
+        ("credential-a", 2, "model-a", "chat"),
+        ("credential-a", 1, "model-b", "chat"),
