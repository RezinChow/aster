{
  "schema": {
    "GenerateReqInput": {
      "text": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "title": "Text"
      },
      "input_ids": {
        "title": "Input Ids"
      },
      "sampling_params": {
        "anyOf": [
          {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Sampling Params"
      },
      "return_logprob": {
        "anyOf": [
          {
            "items": {
              "type": "boolean"
            },
            "type": "array"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "title": "Return Logprob"
      },
      "logprob_start_len": {
        "anyOf": [
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Logprob Start Len"
      },
      "top_logprobs_num": {
        "anyOf": [
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Top Logprobs Num"
      },
      "return_text_in_logprobs": {
        "type": "boolean",
        "title": "Return Text In Logprobs",
        "default": false
      },
      "rid": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "title": "Rid"
      },
      "stream": {
        "type": "boolean",
        "title": "Stream",
        "default": false
      }
    },
    "TokenizeReqInput": {}
  },
  "routes": [
    "/generate"
  ]
}
