+// Aster H200 experiment, derived from the MIT-licensed Xolotl fork_vecdot.cuh.
+// Decode once per weight part, then apply to each verification token. Defaults off.
+// Preserve the original per-lane iteration, block scale order and warp reduction.
+#pragma once
+static_assert(Fmt<143>::ipb == 1, "Aster PTQ split requires the original whole-block layout");
+
+template<> struct Split<143> {
+    struct W { int q[32]; float d; };
+    template<bool STAGE_GRID = false>
+    __device__ static W load(const void* vbq, int kbx, int iqs, const uint32_t* = nullptr) {
+        const auto* b = (const strata_block_ptq1_0*) vbq + kbx;
+        W r;
+        r.d = __half2float(b->d);
+        const uint32_t* words = (const uint32_t*) b->qs;
+#pragma unroll
+        for (int w = 0; w < 6; ++w) {
+            const uint32_t p = words[w];
+            uint32_t lo = __byte_perm(p, 0, 0x4140), hi = __byte_perm(p, 0, 0x4342);
+#pragma unroll
+            for (int t = 0; t < 5; ++t) {
+                const uint32_t wl = lo * 3u, wh = hi * 3u;
+                lo = wl & 0x00FF00FFu; hi = wh & 0x00FF00FFu;
+                const int e = w < 4 ? t * 16 + 4 * w : 80 + t * 8 + 4 * (w - 4);
+                r.q[e / 4] = __vsub4(__byte_perm(wl, wh, 0x7531), 0x01010101);
+            }
+        }
+        r.q[30] = 0; r.q[31] = 0;
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            uint32_t v = b->qh[h];
+#pragma unroll
+            for (int t = 0; t < 4; ++t) {
+                const uint32_t w = v * 3u;
+                v = w & 0xFFu;
+                const int e = 120 + 2 * t + h;
+                const uint32_t digit = (uint32_t)((int)(w >> 8) - 1) & 0xFFu;
+                r.q[e / 4] |= (int)(digit << (8 * (e % 4)));
+            }
+        }
+        return r;
+    }
+    __device__ static float apply(const W& r, const block_q8_1* x, int iqs) {
+        float acc = 0.0f;
+#pragma unroll
+        for (int b = 0; b < 4; ++b) {
+            int sum = 0;
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                sum = ggml_cuda_dp4a(r.q[8*b+j], get_int_b4(x[iqs+b].qs, j), sum);
+            // Integer rearrangement is exact: |sum| <= 32*127; same float expression order.
+            acc += __low2float(x[iqs+b].ds) * (float)sum;
+        }
+        return r.d * acc;
+    }
+};
+
+template<> struct Split<11> {
+    struct W { int q[QR3_K], sc[QR3_K]; float d; };
+    template<bool STAGE_GRID = false>
+    __device__ static W load(const void* vbq, int kbx, int iqs, const uint32_t* = nullptr) {
+        const auto* b = (const block_q3_K*)vbq + kbx;
+        const int off = QR3_K * (iqs / (QI3_K / 2));
+        const int so = iqs - iqs % QI8_1 + (iqs % QI8_1) / (QI8_1/2);
+        const int vl = get_int_b2(b->qs, iqs);
+        const int vh = ~get_int_b2(b->hmask, iqs % (QI3_K/2)) >> off;
+        W r; r.d = __half2float(b->d);
+#pragma unroll
+        for (int i = 0; i < QR3_K; ++i) {
+            const int isc = so + 2*i;
+            const int low = (b->scales[isc % (QK_K/32)] >> (4*(isc/(QK_K/32)))) & 15;
+            const int high = ((b->scales[QK_K/32 + isc % (QK_K/64)] >> (2*(isc/(QK_K/64)))) & 3) << 4;
+            r.sc[i] = (low | high) - 32;
+            r.q[i] = __vsubss4((vl >> (2*i)) & 0x03030303, ((vh >> i) << 2) & 0x04040404);
+        }
+        return r;
+    }
+    __device__ static float apply(const W& r, const block_q8_1* x, int iqs) {
+        const int off = QR3_K * (iqs / (QI3_K/2));
+        float sum = 0.0f;
+#pragma unroll
+        for (int i = 0; i < QR3_K; ++i) {
+            const int u = get_int_b4(x[off+i].qs, iqs % QI8_1);
+            sum += __low2float(x[off+i].ds) * (ggml_cuda_dp4a(r.q[i], u, 0) * r.sc[i]);
+        }
+        return r.d * sum;
+    }
+};
+
+static bool aster_xq_split_enabled(int type) {
+    static const int selected = [] {
+        const char* v = std::getenv("ASTER_XQ_SPLIT_MMVQ");
+        if (!v || std::strcmp(v,"0")==0) return 0;
+        if (std::strcmp(v,"143")==0) return 143;
+        if (std::strcmp(v,"11")==0) return 11;
+        if (std::strcmp(v,"both")==0) return -1;
+        std::fprintf(stderr,"ASTER_XQ_SPLIT_MMVQ must be 0, 143, 11 or both\n");
+        std::abort();
+    }();
+    return selected == -1 || selected == type;
+}
