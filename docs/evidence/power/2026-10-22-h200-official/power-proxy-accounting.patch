diff --git a/src/backend/proxy_usage_tests.rs b/src/backend/proxy_usage_tests.rs
new file mode 100644
index 0000000..f3637eb
--- /dev/null
+++ b/src/backend/proxy_usage_tests.rs
@@ -0,0 +1,98 @@
+use super::*;
+use futures::StreamExt;
+use serde_json::json;
+
+#[test]
+fn rejects_negative_inconsistent_and_overflowing_usage() {
+    assert!(proxy_chat_usage(&json!({"usage":null})).unwrap().is_none());
+    for value in [
+        json!({"prompt_tokens":-1,"completion_tokens":3,"total_tokens":2}),
+        json!({"prompt_tokens":10,"completion_tokens":3,"total_tokens":12}),
+        json!({"prompt_tokens":u64::MAX,"completion_tokens":1,"total_tokens":0}),
+        json!({"prompt_tokens":10,"completion_tokens":3}),
+    ] {
+        assert!(proxy_chat_usage(&json!({"usage":value})).is_err());
+    }
+}
+
+#[tokio::test]
+async fn upstream_client_refusal_is_not_an_inference_server_failure() {
+    use axum::{http::StatusCode, routing::post, Router};
+    let app = Router::new().route(
+        "/v1/chat/completions",
+        post(|| async { StatusCode::BAD_REQUEST }),
+    );
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    let mut config = PowerConfig::default();
+    config
+        .proxy_upstreams
+        .insert("test".into(), format!("http://{address}"));
+    let request = serde_json::from_value::<ChatRequest>(json!({
+        "messages":[{"role":"user","content":"hello"}]
+    }))
+    .unwrap();
+    let error = match ProxyBackend::new(Arc::new(config))
+        .chat("test", request)
+        .await
+    {
+        Ok(_) => panic!("an upstream 400 must refuse the request"),
+        Err(error) => error,
+    };
+    assert!(matches!(error, PowerError::InvalidRequest(_)));
+    server.abort();
+}
+
+#[tokio::test]
+async fn coalesced_text_and_late_usage_keep_authoritative_counts() {
+    use axum::{routing::post, Json, Router};
+    let app = Router::new().route("/v1/chat/completions", post(|Json(body): Json<serde_json::Value>| async move {
+        assert_eq!(body["stream"], true);
+        assert_eq!(body["stream_options"]["include_usage"], true);
+        concat!(
+            "data: {\"choices\":[{\"delta\":{\"content\":\"many tokens in one chunk\"},\"finish_reason\":null}]}\n\n",
+            "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n",
+            "data: {\"choices\":[],\"usage\":{\"prompt_tokens\":4294967300,\"completion_tokens\":37,\"total_tokens\":4294967337}}\n\n",
+            "data: [DONE]\n\n"
+        )
+    }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    let mut config = PowerConfig::default();
+    config
+        .proxy_upstreams
+        .insert("test".into(), format!("http://{address}"));
+    let request = serde_json::from_value::<ChatRequest>(json!({
+        "messages":[{"role":"user","content":"hello"}],
+        "stream_options":{"include_usage":false}
+    }))
+    .unwrap();
+    let mut stream = ProxyBackend::new(Arc::new(config))
+        .chat("test", request)
+        .await
+        .unwrap();
+    let mut output = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        output.push(chunk.unwrap());
+    }
+    assert_eq!(
+        output
+            .iter()
+            .filter(|chunk| !chunk.content.is_empty())
+            .count(),
+        1
+    );
+    let last = output.last().unwrap();
+    assert!(last.done);
+    assert_eq!(
+        last.upstream_timings.as_ref().unwrap()["usage"]["completion_tokens"],
+        37
+    );
+    assert_eq!(
+        last.upstream_timings.as_ref().unwrap()["usage"]["prompt_tokens"],
+        4_294_967_300_u64
+    );
+    server.abort();
+}
