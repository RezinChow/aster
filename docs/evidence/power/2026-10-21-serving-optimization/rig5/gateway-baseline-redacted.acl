mode { kind = "standalone" }
entrypoints "qualification" { address = "127.0.0.1:19884" }
routers "health" {
  rule = "Path(`/health`)"
  service = "power"
  entrypoints = ["qualification"]
  priority = 100
}
routers "qualification" {
  rule = "PathPrefix(`/v1/`)"
  service = "power"
  entrypoints = ["qualification"]
  middlewares = ["benchmark-auth"]
}
services "power" {
  load_balancer {
    strategy = "round-robin"
    request_timeout = "135s"
    stream_idle_timeout = "30s"
    stream_total_timeout = "135s"
    servers = [{ url = "http://127.0.0.1:19400" }]
  }
}
middlewares "benchmark-auth" {
  type = "api-key"
  header = "Authorization"
  keys = ["Bearer BENCHMARK_KEY_REDACTED"]
}
observability {
  metrics_enabled = true
  access_log_enabled = false
  tracing_enabled = false
}
