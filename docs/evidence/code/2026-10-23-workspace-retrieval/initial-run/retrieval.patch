+    let semantic_fallback = semantic_fallback
+        .filter(|fallback| !matches!(fallback, WorkspaceHybridFallbackReason::FilteredStaleHits));
+    let fallback = if snapshot.source_revision() == 0 {
+        for channel in &mut channels {
