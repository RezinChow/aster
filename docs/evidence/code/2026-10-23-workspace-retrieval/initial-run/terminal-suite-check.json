{
  "name": "aster-workspace-retrieval",
  "version": 1,
  "scenarios": [
    {
      "id": "hybrid-retains-late-source-evidence",
      "name": "hybrid-retains-late-source-evidence",
      "surface": "tui",
      "timeout_ms": 60000,
      "steps": [
        {
          "id": "ready",
          "action": {
            "type": "wait",
            "condition": {
              "type": "text",
              "value": "mock/gpt"
            }
          }
        },
        {
          "id": "query",
          "action": {
            "type": "terminal_paste",
            "text": "RETRIEVAL-ORACLE: find the workspace retrieval probe using hybrid search"
          }
        },
        {
          "id": "submit",
          "action": {
            "type": "press",
            "key": "Enter"
          }
        },
        {
          "id": "verified-response",
          "action": {
            "type": "wait",
            "condition": {
              "type": "text",
              "value": "RETRIEVAL-EVIDENCE-VERIFIED"
            }
          }
        },
        {
          "id": "verified-screen",
          "action": {
            "type": "snapshot",
            "interactive": true
          }
        },
        {
          "id": "retrieval-recording",
          "action": {
            "type": "terminal_recording",
            "path": "terminal/retrieval.vt"
          }
        }
      ]
    }
  ]
}
