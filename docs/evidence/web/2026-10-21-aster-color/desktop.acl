suite "aster-download-browser" {
    version = 1

    scenario "desktop-real-gallery" {
        name = "Real Aster screenshots, feature tabs, native dialogs and back to top"
        surface = "web"
        timeout_ms = 60000

        viewport "desktop" { width = 1440 height = 900 scale = 1 }
        navigate "download-page" { url = "http://127.0.0.1:4188/download/" }
        click "enlarge-real-workspace" { target = css(".hero-screen [data-screenshot='workspace']") }
        expect "workspace-image-in-modal" { visible = css("#screenshot-dialog #screenshot-full[src='./screenshots/workspace.png'][alt='Aster 工作区真实界面，演示数据']") }
        press "close-image-with-escape" { key = "Escape" }
        wait "image-dialog-closed" { hidden = css("#screenshot-dialog") }
        click "header-download" { target = css(".site-header [data-download]") }
        expect "download-choices-visible" { visible = css("#download-dialog .download-options") }
        press "close-download-with-escape" { key = "Escape" }
        wait "download-dialog-closed" { hidden = css("#download-dialog") }
        expect "download-focus-restored" { focused = css(".site-header [data-download]") }
        focus "workspace-tab" { target = css("#feature-workspace") }
        expect "workspace-panel" { visible = css("#feature-panel-workspace .screenshot-figure") }
        screenshot "workspace-color" { path = "screenshots/feature-workspace.png" }
        press "next-office" { key = "ArrowRight" }
        expect "office-panel" { visible = css("#feature-panel-office .screenshot-figure") }
        screenshot "office-color" { path = "screenshots/feature-office.png" }
        press "next-review" { key = "ArrowRight" }
        expect "review-panel" { visible = css("#feature-panel-review .screenshot-figure") }
        screenshot "review-color" { path = "screenshots/feature-review.png" }
        press "next-lineage" { key = "ArrowRight" }
        expect "lineage-panel" { visible = css("#feature-panel-lineage .screenshot-figure") }
        screenshot "lineage-color" { path = "screenshots/feature-lineage.png" }
        wait "back-to-top-shown" { visible = css(".back-to-top") }
        click "back-to-top" { target = role("button", "回到顶部") }
        wait "back-to-top-hidden" { hidden = css(".back-to-top") }
        expect "brand-focus-restored" { focused = css(".site-header .brand") }
        screenshot "desktop-final" { path = "screenshots/desktop-gallery.png" }
        focus "desktop-bottom-cta" { target = css(".bottom-cta [data-download]") }
        screenshot "desktop-ornaments" { path = "screenshots/desktop-cta.png" }
        page_errors "desktop-errors" { path = "evidence/desktop-errors.json" clear = false }
    }

}
