suite "aster-feature-colors" {
    version = 1
    scenario "desktop-feature-colors" {
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 900 scale = 1 }
        navigate "download" { url = "http://127.0.0.1:4188/download/" }
        click "workspace-tab" { target = role("tab", "工作区") }
        focus "workspace-image" { target = css("#feature-panel-workspace .screenshot-button") }
        wait "workspace-loaded" { load = "networkidle" }
        screenshot "workspace-frame" { path = "screenshots/workspace.png" }
        click "office-tab" { target = role("tab", "Office") }
        focus "office-image" { target = css("#feature-panel-office .screenshot-button") }
        wait "office-loaded" { load = "networkidle" }
        screenshot "office-frame" { path = "screenshots/office.png" }
        click "review-tab" { target = role("tab", "自动审查") }
        focus "review-image" { target = css("#feature-panel-review .screenshot-button") }
        wait "review-loaded" { load = "networkidle" }
        screenshot "review-frame" { path = "screenshots/review.png" }
        click "lineage-tab" { target = role("tab", "产物追溯") }
        focus "lineage-image" { target = css("#feature-panel-lineage .screenshot-button") }
        wait "lineage-loaded" { load = "networkidle" }
        screenshot "lineage-frame" { path = "screenshots/lineage.png" }
        page_errors "errors" { path = "evidence/errors.json" clear = false }
    }
}
