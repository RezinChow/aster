/target/
/target-merge-check/
**/target/
/crates/capture/.build/
.DS_Store
**/.DS_Store

.env
.env.*
!.env.example
# Product runtime under workspace/.aster (sessions/memory/config.acl/…).
# Engineering markers may be tracked when present (HG6 / Q14); do not un-ignore
# config.acl (often secrets).
.aster/*
!.aster/MANIFEST.json
!.aster/project.acl
!.aster/project.acl.example
!.aster/ENGINEERING.md
!.aster/README.md
!.aster/.gitignore
!.aster/skills/
!.aster/skills/**
!.aster/workflow/
!.aster/workflow/**
!.aster/wiki/
!.aster/wiki/**
!.aster/evidence/
!.aster/evidence/**
!.aster/agent-rules/
!.aster/agent-rules/**
!.aster/contexts/
!.aster/contexts/**
!.aster/extensions/
!.aster/extensions/**
!.aster/lanes/
!.aster/lanes/**
!.aster/migration/
!.aster/migration/**
!.aster/workflows/
!.aster/workflows/**
.aster-test/
.aster-agent-retrievals
.aster-vec.lock
.aster-vec.lock.owner
!crates/**/fixtures/**/.aster/
!crates/**/fixtures/**/.aster/**
*.profraw
*.profdata
__pycache__/
.pytest_cache/

# Local snapshots taken before refreshing Cargo.lock
*.lock.bak
*.lock.tag

# Local frontend installations.
**/node_modules/

# Local test fixtures, archives, and reversible migration snapshots.
/.tmp/
/.local-archive/
/.codex-worktrees/
/target-e2e/

# Scratch agent worktrees and local experiment checkouts. Never a product path.
/work/

# Local CUA / GUI / release scratch outputs (never product evidence).
/artifacts/
/segments/

# Harbor job directories from local Terminal-Bench / Harbor runs.
/jobs/

# Generated artifacts: the WorkBuddy desktop agent's repo-local memory and
# the T01 harness output directory.
/.workbuddy/
/tests/T01/output/
/crates/code/core/.aster-vec.lock
/crates/code/core/.aster-vec.lock.owner

# Swift Package Manager products for the internal Capture engine.
/crates/capture/.build/

# Local web build outputs.
/apps/web/dist/
/apps/web/.astro/

# Mutable aster-vec index state from package-local development runs.
/crates/code/core/manifest.json
/crates/code/core/segments/

# Local CLI release staging (never commit archives)
/dist/

# Local wiki workspace (runtime-maintained, never product evidence).
/wiki/

# Local WIP patch backup from release-readiness remediation.
# Contains uncommitted user code; keep it on disk but never put it in git history.
/docs/evidence/studio/2026-11-14-release-readiness/wip-backup/

# Release readiness reports are derived, reproducible outputs. Keeping them
# out of git avoids the read-only gate dirtying its own evidence on re-run.
/docs/evidence/studio/2026-11-14-release-readiness/readiness-report.json
/docs/evidence/studio/2026-11-14-release-readiness/readiness-report.txt
/docs/evidence/studio/2026-11-14-release-readiness/readiness-run.stdout.log
