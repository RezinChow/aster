# Aster — project config (P16)
# Spec: kense/kstudio/docs/project-config-kcl.md
# 机队形状参考 ../inkstone/.kstudio/config.kcl；私人 SSH / 远端路径 → config.local.kcl + env()
# Secrets: env("VAR") only. prefer_* = hints, not silent binding.

schema = "kstudio.project-config.v1"

fleet {
  machine "mac-dev" {
    class = "macos-desktop"
    label = "macOS 本机（Aster 主实现）"
    notes = "CLI / Core·ACP / Studio 主攻与本地 verify"

    connect {
      via = "local"
      command = "本机打开 aster 仓根（勿用 Windows 闸门机冒充）"
      workdir = "."
    }

    use {
      summary = "Aster 主实现：Rust 构建、本地测试、Studio 相关检查"
      open_session = "Cursor 打开本仓 → 新 Agent；终端在仓根"
      typical = "just build / 聚焦 cargo test；按席位 roles/*.md；studio 按 land 纪律"
      verify = "证据路径写入 handoff；会合机能 checkout sha"
      dont = "≠ win-gates；无口令不推 main；%≠Pass；L3≠产品 Pass"
    }
  }

  machine "win-gates" {
    class = "windows-desktop"
    label = "Windows 主机（侧翼 / 闸门）"
    notes = "侧翼 R；跨平台与 Windows 发布相关。host/workdir 按本机改或放到 config.local.kcl"

    connect {
      via = "ssh"
      host = "win-gates"
      command = "ssh win-gates"
      workdir = "D:/code/aster"
    }

    use {
      summary = "Windows 原生构建 / 闸门 / 跨平台验证"
      open_session = "ssh win-gates → cd 到 workdir → 开远端 Agent 或 PowerShell"
      typical = "Windows 目标构建与项目既有 qualify/release 相关检查"
      verify = "证据回传或落到 mac 会合可达路径；77≠Pass"
      dont = "不要当 mac-dev；密码勿写入本文件；用 ssh-agent"
    }
  }

  machine "docs-any" {
    class = "any-writable"
    label = "任意可写仓的工作机"

    connect {
      via = "local"
      command = "任意已 clone 本仓的工作机"
      workdir = "."
    }

    use {
      summary = "文档 / 复盘 / .kstudio 编排"
      open_session = "打开本仓即可"
      typical = "编辑 .kstudio/wiki、GOALS、evidence"
      verify = "入口与专文一致"
      dont = "不要在此席改业务源码"
    }
  }
}

agents {
  agent "cursor" {
    kind = "cursor"
    label = "Cursor Agent"
  }
  agent "codex" {
    kind = "codex"
    label = "Codex"
  }
}

models {
  model "default" {
    id = "default"
    label = "日常实现模型"
  }
  model "investigate" {
    id = "strong"
    label = "疑难强模型（I）"
  }
}

prefs {
  role "O" {
    prefer_agent = "cursor"
  }
  role "B" {
    prefer_machine = "mac-dev"
    prefer_model = "default"
  }
  role "R" {
    prefer_machine = "win-gates"
    prefer_model = "default"
  }
  role "M" {
    prefer_machine = "mac-dev"
  }
  role "I" {
    prefer_machine = "mac-dev"
    prefer_model = "investigate"
  }
  role "S" {
    prefer_machine = "docs-any"
  }
  role "D" {
    prefer_machine = "docs-any"
  }
}
