suite "aster-native-form" {
  version = 1

  scenario "submit-and-validation" {
    surface = "tui"
    timeout_ms = 60000

    wait "welcome" { text = "Aster" }
    terminal_paste "question" { text = "FORM-ORACLE-SUBMIT" }
    press "send" { key = "Enter" }
    wait "form" { text = "Aster form" }
    press "amount" { key = "Tab" }
    press "ready" { key = "Tab" }
    press "actions" { key = "Tab" }
    press "submit-empty" { key = "Enter" }
    wait "required" { regex = "┃[ ]+required" }
    snapshot "required-fields" {}
    press "back-ready" { key = "Up" }
    press "back-amount" { key = "Up" }
    press "back-name" { key = "Up" }
    press "edit-name" { key = "Enter" }
    terminal_paste "name" { text = "Ada" }
    press "finish-name" { key = "Enter" }
    press "next-amount" { key = "Tab" }
    press "edit-amount" { key = "Enter" }
    press "clear-amount-1" { key = "Backspace" }
    press "clear-amount-2" { key = "Backspace" }
    press "clear-amount-3" { key = "Backspace" }
    terminal_paste "too-large" { text = "6" }
    press "finish-amount" { key = "Enter" }
    press "next-ready" { key = "Tab" }
    press "check-ready" { key = "Right" }
    press "next-actions" { key = "Tab" }
    press "submit-invalid" { key = "Enter" }
    snapshot "invalid-fields" {}
    terminal_recording "validation" { path = "terminal/validation.vt" }
    wait "range-error" { text = "max 5" }
    press "return-ready" { key = "Up" }
    press "return-amount" { key = "Up" }
    press "correct-amount" { key = "Enter" }
    press "clear-invalid" { key = "Backspace" }
    terminal_paste "valid-amount" { text = "4" }
    press "finish-correction" { key = "Enter" }
    press "valid-ready" { key = "Tab" }
    press "valid-actions" { key = "Tab" }
    press "submit-valid" { key = "Enter" }
    wait "typed-values-reached-agent" { text = "FORM-SUBMITTED" }
    snapshot "submitted" {}
    terminal_recording "submission" { path = "terminal/submission.vt" }
    terminal_paste "quit" { text = "/quit" }
    press "exit" { key = "Enter" }
    wait "aster-resume-command" { text = "aster --resume " }
    terminal_recording "resume-hint" { path = "terminal/resume.vt" }
  }

  scenario "cancel" {
    surface = "tui"
    timeout_ms = 60000

    wait "welcome" { text = "Aster" }
    terminal_paste "question" { text = "FORM-ORACLE-CANCEL" }
    press "send" { key = "Enter" }
    wait "form" { text = "Aster form" }
    press "cancel" { key = "Control+c" }
    wait "cancel-reached-agent" { text = "FORM-CANCELLED" }
    terminal_recording "cancelled" { path = "terminal/cancelled.vt" }
  }

  scenario "unsupported-form" {
    surface = "tui"
    timeout_ms = 60000

    wait "welcome" { text = "Aster" }
    terminal_paste "question" { text = "FORM-ORACLE-INVALID" }
    press "send" { key = "Enter" }
    wait "rejection-reached-agent" { text = "FORM-REJECTED" }
    terminal_recording "rejected" { path = "terminal/rejected.vt" }
  }
}
