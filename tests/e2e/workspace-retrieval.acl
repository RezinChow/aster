suite "aster-workspace-retrieval" {
  version = 1

  scenario "hybrid-retains-late-source-evidence" {
    surface = "tui"
    timeout_ms = 60000

    wait "welcome" { text = "Aster" }
    snapshot "startup" {}
    wait "ready" { text = "mock/gpt" }
    terminal_paste "query" {
      text = "RETRIEVAL-ORACLE: find the workspace retrieval probe using hybrid search"
    }
    press "submit" { key = "Enter" }
    wait "verified-response" { text = "RETRIEVAL-EVIDENCE-VERIFIED" }
    snapshot "verified-screen" {}
    terminal_recording "retrieval-recording" { path = "terminal/retrieval.vt" }
  }
}
