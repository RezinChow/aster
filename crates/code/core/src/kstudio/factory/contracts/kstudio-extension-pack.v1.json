{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kstudio.extension-pack.v1",
  "title": "KStudio .kstudio extension pack (extension.toml)",
  "description": "Contributes optional templates, wiki namespaces, evidence roots, hooks, contexts. Unknown keys ignored. Cannot redefine stable core path semantics.",
  "type": "object",
  "required": ["id", "version", "api_version"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "api_version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "contributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "id": { "type": "string" }
            }
          }
        },
        "wiki_namespace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "type": "string" } }
          }
        },
        "evidence_roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "type": "string" } }
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["on", "script"],
            "properties": {
              "on": {
                "type": "string",
                "enum": ["workflow.gate", "workflow.created", "evidence.recorded"]
              },
              "script": { "type": "string" },
              "enabled_by_default": { "type": "boolean", "default": false }
            }
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
